# 模型（方舟）
MODEL_AGENT_NAME=
MODEL_AGENT_API_KEY=

# veADK DEBUG 会输出完整工具响应；Knowledge 场景必须使用 INFO 或更高等级
LOGGING_LEVEL=INFO

# 盖亚
GAIA_DRY_RUN=true

# 知识库后端：stub=本地桩；agentkit=AgentKit/Viking 资源（官方 SDK 直连）
KB_BACKEND=stub

# 真库模式必填：scope 对应的 collection 名
KB_COLLECTION_POLICY=policy
KB_COLLECTION_HANDBOOK=handbook
KB_COLLECTION_SALARY=salary
KB_COLLECTION_CHILDCARE=childcare

# Viking 官方 SDK 连接。值为空时使用官方 SDK 自身默认值，应用代码不硬编码。
VIKING_KNOWLEDGE_HOST=
VIKING_KNOWLEDGE_REGION=
VIKING_KNOWLEDGE_SCHEME=https
VIKING_KNOWLEDGE_PROJECT=

# 本地鉴权：火山引擎 AK/SK；临时凭据同时配置 SESSION_TOKEN
# 获取：console.volcengine.com/iam/keymanager
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
VOLCENGINE_SESSION_TOKEN=

# Orchestrator迁移开关：只允许local或a2a
HR_CONSULT_TRANSPORT=local
HR_EMPLOYEE_DATA_TRANSPORT=local
HR_CONSULT_A2A_URL=http://127.0.0.1:8101
HR_EMPLOYEE_DATA_A2A_URL=http://127.0.0.1:8102
HR_A2A_TIMEOUT_SECONDS=30

# Employee Data服务端可信身份与数据源
# 仅示例虚构身份，真实映射不得提交
EMPLOYEE_IDENTITY_MAP_JSON='{"local-user":"EMP-EXAMPLE"}'
EMPLOYEE_REF_SECRET=
EMPLOYEE_DATA_BACKEND=gaia
GAIA_CORP_ID=
GAIA_CLIENT_SECRET=
GAIA_GRANT_TYPE=client_credentials
# 排班租户（服务端配置，不再代码写死 snowbeertest）
GAIA_SCHEDULE_TENANT=

# 仅EMPLOYEE_DATA_BACKEND=stub时使用；成功响应必须标记source=stub
EMPLOYEE_DATA_STUB_JSON=

# 顶层公共A2A Provider（SnowHarness接入）：端点与访问配置唯一Authority
HR_ASSISTANT_A2A_HOST=127.0.0.1
HR_ASSISTANT_A2A_PORT=8100
HR_ASSISTANT_A2A_PUBLIC_URL=http://127.0.0.1:8100
HR_ASSISTANT_A2A_AUTH_MODE=none
# bearer模式必填（只证明调用权，与execution_subject无关）
# HR_ASSISTANT_A2A_BEARER_TOKEN=

# 公共执行主体映射：用 scripts/public_subject_ref.py 从
# subject_kind+subject_id 计算 internal_user_id，再私下在
# EMPLOYEE_IDENTITY_MAP_JSON 配置 internal_user_id -> employeeId。
# 真实映射与token永不提交git。
