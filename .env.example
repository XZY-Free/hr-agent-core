# 模型（方舟）。模型服务端运行于 AgentKit Runtime，由服务端注入。
MODEL_AGENT_NAME=
MODEL_AGENT_API_KEY=

# veADK DEBUG 会输出完整工具响应；Knowledge 场景必须使用 INFO 或更高等级
LOGGING_LEVEL=INFO

# ---- 公共 A2A 入口（Orchestrator 公共 hr-assistant）----
# 服务端监听与访问配置，由 apps/orchestrator/public_a2a/settings.py 消费。
HR_ASSISTANT_A2A_HOST=0.0.0.0
HR_ASSISTANT_A2A_PORT=8000
# 公网可通告 URL：留空必填，不得写 loopback。本地源码已接入 deployment.runtime_entry
# （orchestrator -> apps.orchestrator.public_a2a），云端入口已与本地一致。
HR_ASSISTANT_A2A_PUBLIC_URL=
HR_ASSISTANT_A2A_AUTH_MODE=bearer
# bearer 模式下的 Runtime Access Credential（只证明调用权）。
HR_ASSISTANT_A2A_BEARER_TOKEN=

# ---- Gaia / Employee Data 后端 ----
# 授权开发假数据方式（用户明确授权，非阻塞项）。
GAIA_DRY_RUN=true
GAIA_BACKEND=stub
EMPLOYEE_DATA_BACKEND=stub
# 真实 Gaia 配置（GAIA_CORP_ID / GAIA_CLIENT_SECRET / GAIA_GRANT_TYPE / GAIA_SCHEDULE_TENANT）：
# 仅在 GAIA_BACKEND=gaia（默认）下必需；GAIA_BACKEND=stub 且干跑时不要求这四项。
# 本地源码已修正（packages/hr_domain/gaia/config.py：显式 stub + GAIA_DRY_RUN=true 时返回不带
# 凭据的配置，默认 gaia 仍校验四项，未知 backend 拒绝），云端配置已与本地一致。
# 服务端可信身份（EMPLOYEE_IDENTITY_MAP_JSON / EMPLOYEE_REF_SECRET）仍必需，且不是 Gaia 例外。
GAIA_CORP_ID=
GAIA_CLIENT_SECRET=
GAIA_GRANT_TYPE=client_credentials
GAIA_SCHEDULE_TENANT=
# 授权 stub 配置：为 JSON 字符串（不是文件路径），留空必填，不造内容；成功响应必须 source=stub。
GAIA_STUB_JSON=
EMPLOYEE_DATA_STUB_JSON=

# ---- 知识库（Consult）----
KB_BACKEND=agentkit
# 四个 collection 映射：留空必填，不填示例真实值。
KB_COLLECTION_POLICY=
KB_COLLECTION_HANDBOOK=
KB_COLLECTION_SALARY=
KB_COLLECTION_CHILDCARE=
# Viking 官方 SDK 连接：按资源配置；可选项为空时使用官方 SDK 自身默认值，应用代码不硬编码。
VIKING_KNOWLEDGE_HOST=
VIKING_KNOWLEDGE_REGION=
VIKING_KNOWLEDGE_SCHEME=https
VIKING_KNOWLEDGE_PROJECT=

# 火山引擎鉴权：AK/SK，STS 时同时配置 SESSION_TOKEN；REGION 供官方 SDK 客户端使用。
# 获取：console.volcengine.com/iam/keymanager；密文只通过 Runtime secret / IAM 注入，不进 Git。
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
VOLCENGINE_REGION=
VOLCENGINE_SESSION_TOKEN=

# ---- Orchestrator 下游 A2A（指向 Consult / Employee Data 云服务）----
# 留空必填，不写 loopback；未显式配置时代码保留本地默认，生产装配需显式设置。
HR_CONSULT_A2A_URL=
HR_EMPLOYEE_DATA_A2A_URL=
# 下游 Runtime 服务端 API Key。
HR_CONSULT_RUNTIME_API_KEY=
HR_EMPLOYEE_DATA_RUNTIME_API_KEY=
HR_A2A_TIMEOUT_SECONDS=30
# 下游 AgentCard 的基础 URL（apps/<agent>/a2a/card.py 各自读取）。
HR_CONSULT_A2A_BASE_URL=
HR_EMPLOYEE_DATA_A2A_BASE_URL=

# ---- 服务端可信身份 ----
# A2A user_id -> internal employeeId 映射：留空必填，真实映射不得提交。
EMPLOYEE_IDENTITY_MAP_JSON=
# 生成不可逆 employee_ref 的服务端共享身份密钥。
EMPLOYEE_REF_SECRET=

# ---- AgentKit 验收测试客户端（执行测试进程环境安全注入，只留空占位）----
# 三个 Runtime 的服务端 API Key。
HR_ACCEPTANCE_ORCHESTRATOR_API_KEY=
HR_ACCEPTANCE_CONSULT_API_KEY=
HR_ACCEPTANCE_EMPLOYEE_API_KEY=
# 待验收的不可变镜像映射：必须显式指定待验收 image，不得从当前云镜像回填制造成功。
# 值为 JSON 对象，键必须精确为 orchestrator / consult / employee_data，各绑定其待验收不可变镜像。
HR_ACCEPTANCE_EXPECTED_IMAGES_JSON=
